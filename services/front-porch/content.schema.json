{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.trueconvo.com/content.schema.json",
  "title": "Front porch public content",
  "type": "object",
  "additionalProperties": false,
  "required": ["about", "features", "faq", "privacy", "status", "updates"],
  "properties": {
    "about": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "maker", "website", "summary", "availability"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "maker": { "type": "string", "minLength": 1, "maxLength": 80 },
        "website": { "type": "string", "pattern": "^https://" },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "availability": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "description": { "type": "string", "minLength": 1, "maxLength": 400 },
          "status": { "enum": ["available", "in development", "planned"] }
        }
      }
    },
    "faq": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "answer"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "question": { "type": "string", "minLength": 1, "maxLength": 200 },
          "answer": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_url", "promises"],
      "properties": {
        "policy_url": { "type": "string", "pattern": "^https://" },
        "promises": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "summary", "public_release", "updated"],
      "properties": {
        "stage": { "enum": ["planned", "in development", "beta", "available"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
        "public_release": { "type": "string", "minLength": 1, "maxLength": 200 },
        "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "title", "summary"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 600 }
        }
      }
    }
  }
}
