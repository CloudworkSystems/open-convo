{
  "openapi": "3.1.0",
  "info": {
    "title": "True Convo front porch API",
    "version": "0.1.0",
    "summary": "Read-only public facts about True Convo.",
    "description": "Answers questions about True Convo, a personal AI app for the Mac, from reviewed public text. It holds no personal data, needs no key and writes no logs of its own. The same answers are available as MCP tools at POST /mcp (Streamable HTTP).",
    "contact": {
      "name": "Cloudwork Systems",
      "url": "https://trueconvo.com",
      "email": "trueconvo2@gmail.com"
    }
  },
  "servers": [
    {
      "url": "https://api.trueconvo.com"
    }
  ],
  "paths": {
    "/v1/about": {
      "get": {
        "operationId": "getAbout",
        "summary": "What True Convo is",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/About"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/features": {
      "get": {
        "operationId": "listFeatures",
        "summary": "Features with their real status",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "features"
                  ],
                  "properties": {
                    "features": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Feature"
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/faq": {
      "get": {
        "operationId": "listFaq",
        "summary": "Frequently asked questions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "faq"
                  ],
                  "properties": {
                    "faq": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/FaqEntry"
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "400": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words that every returned entry must contain (case-insensitive).",
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/v1/privacy": {
      "get": {
        "operationId": "getPrivacy",
        "summary": "Privacy promises",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Privacy"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Development status",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/v1/updates": {
      "get": {
        "operationId": "listUpdates",
        "summary": "Dated update notes, newest first",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "updates"
                  ],
                  "properties": {
                    "updates": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Update"
                      }
                    }
                  }
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "This OpenAPI description",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "405": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "status",
              "message"
            ],
            "properties": {
              "status": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "About": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "maker",
          "website",
          "summary",
          "availability"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "maker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "website": {
            "type": "string",
            "pattern": "^https://"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "availability": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "Privacy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "policy_url",
          "promises"
        ],
        "properties": {
          "policy_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "promises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "summary",
          "public_release",
          "updated"
        ],
        "properties": {
          "stage": {
            "enum": [
              "planned",
              "in development",
              "beta",
              "available"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "public_release": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "updated": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      },
      "Feature": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "status": {
            "enum": [
              "available",
              "in development",
              "planned"
            ]
          }
        }
      },
      "FaqEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "answer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      },
      "Update": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "title",
          "summary"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      }
    }
  }
}
